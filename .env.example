# Copy this file to .env and fill in real values. .env is git-ignored.

# Model provider (DeepSeek or HKGAI)
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Search (leave empty to fall back to key-less scraping; the trace emits search_degraded)
SEARCH_API_KEY=

# Git sandbox repository (must NOT point at this repository)
GITHUB_TOKEN=
GITHUB_SANDBOX_REPO=

# Copy this file to .env and fill in real values. .env is git-ignored.
# Nothing reads .env automatically yet: export the variables, or let the application
# loader read the file. See docs/local-setup.md.
# Use your own keys. Never commit them, paste them in chat, or put them in a screenshot.

# Current adapter: DeepSeek. HKGAI is allowed by the course but needs a separate adapter.
# Model names as of 2026-11: deepseek-flash (default) or deepseek-v4-pro.
# deepseek-chat and deepseek-reasoner are retired; requests using them fail.
# The client appends /chat/completions itself, so the base URL must not end in /v1.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash

# Search: each member registers their own key. Without it, web_search fails with an
# explicit error; there is no key-less scraping fallback. CI never sets this.
SEARCH_API_KEY=

# Git sandbox repository (must NOT point at this repository)
GITHUB_TOKEN=
GITHUB_SANDBOX_REPO=

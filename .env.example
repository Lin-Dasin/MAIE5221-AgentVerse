# Copy this file to .env and fill in real values. .env is git-ignored.
# Nothing reads .env automatically yet: export the variables, or let the application
# loader read the file. See docs/local-setup.md.
# Use your own keys. Never commit them, paste them in chat, or put them in a screenshot.

# Current adapter: DeepSeek. HKGAI is allowed by the course but needs a separate adapter.
# Model names as of 2026-11: deepseek-flash (default) or deepseek-v4-pro.
# deepseek-chat and deepseek-reasoner are no longer in the official model table.
# The base URL without /v1 is the documented form; the /v1 suffix is legacy but
# still served (a bad key returns 401, not 404).
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# Explicit mode shared by Planner, Workers and the live smoke probe.
# enabled preserves provider reasoning_content across multi-turn tool calls.
LLM_THINKING=disabled

# Search: each member registers their own key. Without it, web_search fails with an
# explicit error; there is no key-less scraping fallback. CI never sets this.
SEARCH_API_KEY=

# Git sandbox repository. Must NOT point at this repository.
# Accepts an https URL (token injected at call time) or a local path to a bare
# repository, which is enough for offline tests. Without it, git_push fails with
# an explicit "not configured" message instead of silently doing nothing.
GITHUB_TOKEN=
GITHUB_SANDBOX_REPO=

# Code execution backend. `docker` is the default: one short-lived container per call,
# no network, 512 MB memory, 1 CPU, pids limit, read-only root, dropped capabilities.
# Build the image first: docker build -t agentverse-sandbox:latest docker/
# `subprocess` runs on the host with no isolation and must be chosen explicitly.
CODE_EXEC_BACKEND=docker
CODE_EXEC_IMAGE=agentverse-sandbox:latest
# Where the pytest acceptance runner executes: `docker` isolates generated tests,
# `host` is the fallback for machines without a daemon.
PYTEST_BACKEND=host

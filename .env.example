# Copy this file to .env and fill in real values. .env is git-ignored.
# D's application must load it or export these variables; the client does not load .env.

# Current adapter: DeepSeek. HKGAI is allowed by the course but needs a separate adapter.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Planned B adapter: missing search key uses a declared fallback and search_degraded trace.
SEARCH_API_KEY=

# Git sandbox repository (must NOT point at this repository)
GITHUB_TOKEN=
GITHUB_SANDBOX_REPO=
